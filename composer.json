{
    "name": "ahmednour/eloquent-rag",
    "description": "The Eloquent synchronization layer for Laravel AI's RAG stack — model lifecycle sync, dependency tracking, invalidation, chunk management, and rebuild tooling.",
    "keywords": [
        "laravel",
        "eloquent",
        "rag",
        "vector",
        "ai",
        "embeddings"
    ],
    "homepage": "https://github.com/ahmednour/eloquent-rag",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ahmed Nour",
            "email": "ahmednour1430464@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.29",
        "illuminate/queue": "^13.29",
        "illuminate/support": "^13.29",
        "laravel/ai": "^0.11.2"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "laravel/pint": "^1.17",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ahmednour\\EloquentRag\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ahmednour\\EloquentRag\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ahmednour\\EloquentRag\\EloquentRagServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
